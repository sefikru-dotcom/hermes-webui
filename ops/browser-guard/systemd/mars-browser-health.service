[Unit]
Description=Mars WebUI health probe (HTTP, memory PSI, swap, leaked test browsers)
Documentation=file:/opt/hermes-webui/ops/browser-guard/README.md
After=hermes-webui.service

[Service]
Type=oneshot
# run-guard.sh picks a working python3 at run time: a hardcoded
# /opt/hermes-webui/.venv/bin/python3 turns into a dangling uv symlink and the
# unit dies with 203/EXEC. See README "Интерпретатор".
ExecStart=/opt/hermes-webui/ops/browser-guard/run-guard.sh /opt/hermes-webui/ops/browser-guard/browser_health.py
Nice=10
IOSchedulingClass=idle
MemoryMax=96M
# 0 ok, 1 warn — both are "the probe ran". 2 (critical) stays a failed unit.
SuccessExitStatus=0 1
TimeoutStartSec=60
